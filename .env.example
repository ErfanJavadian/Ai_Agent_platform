# Provider selection: "fake" for offline tests, "openai_compatible" for a real model endpoint.
AI_AGENT_PROVIDER=fake

# Required only when AI_AGENT_PROVIDER=openai_compatible.
# Never put a real secret in this file or commit one to Git.
AI_AGENT_API_KEY=
AI_AGENT_MODEL=
AI_AGENT_API_BASE_URL=https://api.openai.com/v1
AI_AGENT_TIMEOUT_SECONDS=30
